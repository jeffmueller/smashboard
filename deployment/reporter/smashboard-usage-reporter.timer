[Unit]
Description=Report Claude Code usage to smashboard every 10 minutes

[Timer]
# Soon after login, so a machine that has just woken reports without waiting
# out a whole interval.
OnStartupSec=2min
OnUnitActiveSec=10min
# The panel treats a report older than 30 minutes as stale; 10 leaves room for
# a missed run without the tile going grey.
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
