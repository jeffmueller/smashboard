# Copy to .env.deploy and adjust. Not committed — see .gitignore.
# The scripts fall back to these same values, so a real deployment should set
# every one of them rather than relying on the defaults.
PI_USER=pi
PI_HOST=raspberrypi.local
# The DNS record has to exist before setup-pi.sh runs — it checks, because a
# failed ACME attempt counts against Let's Encrypt's rate limit.
DOMAIN_NAME=dashboard.example.com
# The port Puma binds on the loopback; nginx proxies to it.
APP_PORT=3012
