# frozen_string_literal: true

namespace :smashboard do
  desc 'Generate a VAPID key pair for Web Push and print it for .env'
  task vapid: :environment do
    keys = WebPush.generate_key
    puts "VAPID_PUBLIC_KEY=#{keys.public_key}"
    puts "VAPID_PRIVATE_KEY=#{keys.private_key}"
  end

  # Everything a self-hosted instance needs, in one paste. Generating these by
  # hand means four separate commands and knowing which belong together; losing
  # them later means every stored credential becomes undecryptable, so the task
  # prints rather than writes and leaves keeping them to whoever runs it.
  # Deliberately does NOT depend on :environment. Booting the app in production
  # needs SECRET_KEY_BASE, which is one of the things this task exists to
  # generate — so requiring the environment would make it impossible to run on a
  # fresh install, which is the only time anyone runs it.
  desc 'Print a complete .env for a self-hosted instance'
  # rubocop:disable-next-line Rails/RakeEnvironment -- see above; :environment is the bug
  task :env do
    require 'securerandom'
    require 'web-push'

    vapid = WebPush.generate_key

    puts <<~ENVFILE
      # Generated by `rails smashboard:env`. Keep this file — rotating any of
      # these keys signs everyone out and makes stored credentials for connected
      # accounts undecryptable.
      SECRET_KEY_BASE=#{SecureRandom.hex(64)}

      ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=#{SecureRandom.alphanumeric(32)}
      ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=#{SecureRandom.alphanumeric(32)}
      ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=#{SecureRandom.alphanumeric(32)}

      VAPID_PUBLIC_KEY=#{vapid.public_key}
      VAPID_PRIVATE_KEY=#{vapid.private_key}
      VAPID_SUBJECT=mailto:you@example.com

      # The database password used by the bundled Postgres container.
      SMASHBOARD_DATABASE_PASSWORD=#{SecureRandom.alphanumeric(24)}

      # The host you will reach this on. Requests arriving under any other Host
      # header are rejected, so this has to match.
      APP_HOST=nas.local

      # Serving over plain HTTP (no TLS in front)? Leave this false. Behind a
      # reverse proxy that terminates TLS, delete the line.
      SMASHBOARD_FORCE_SSL=false
    ENVFILE
  end

  desc 'Refresh every stale panel now'
  task refresh: :environment do
    RefreshStalePanelsJob.perform_now
  end
end
