# Copy to .env and fill in. Generate the three encryption keys with:
#   bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Database (defaults match compose.yaml) ---------------------------------
SMASHBOARD_DATABASE_HOST=localhost
SMASHBOARD_DATABASE_PORT=5433
SMASHBOARD_DATABASE_USER=smashboard
SMASHBOARD_DATABASE_PASSWORD=smashboard

# --- Web push (generate with: bin/rails smashboard:vapid) --------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- OAuth clients ----------------------------------------------------------
# Google — one OAuth client covers both Calendar and Gmail. Register
# https://your-host/oauth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Slack app credentials, shared across every workspace a user connects. Add
# https://your-host/oauth/slack/callback as a redirect URL on the Slack app,
# and request the user scopes channels:read, groups:read, im:read, mpim:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# GitHub OAuth app (falls back to per-user PATs stored on the Connection)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Weather ----------------------------------------------------------------
# NWS needs no key, but asks for a User-Agent naming the app and how to reach
# whoever runs it. Anonymous traffic gets throttled.
NWS_USER_AGENT=smashboard (you@example.com)

# --- Breaking news feed -----------------------------------------------------
# Fallbacks for the news_feed provider, used when a connection leaves the field
# blank. The feed is any server answering GET /api/breaking-news.
NEWS_FEED_BASE_URL=https://news.example.com
# The cookie your feed expects the shared password in. Defaults to "auth".
NEWS_FEED_AUTH_COOKIE=auth
# Optional — the password normally lives encrypted on the connection instead.
NEWS_FEED_PASSWORD=
