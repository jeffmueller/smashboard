<% content_for :title, "Sign in" %>
<% content_for :heading, "Sign in" %>
<% content_for :subheading, "Everything going on in your life, at a glance." %>
<% field = "mt-1 w-full rounded-md border border-line bg-canvas/60 px-3 py-2 text-sm text-ink focus:border-accent/60 focus:outline-none" %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
  <label class="block">
    <span class="block text-xs uppercase tracking-wide text-ink-muted">Email</span>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: field %>
  </label>

  <label class="block">
    <span class="block text-xs uppercase tracking-wide text-ink-muted">Password</span>
    <%= f.password_field :password, autocomplete: "current-password", class: field %>
  </label>

  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2 text-sm text-ink-muted">
      <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-line bg-canvas accent-accent" %>
      Stay signed in
    </label>
  <% end %>

  <%= f.submit "Sign in", class: "w-full rounded-md bg-accent px-4 py-2 text-sm font-medium text-canvas hover:opacity-90" %>
<% end %>
