<% workspaces = data[:workspaces] || [] %>

<% if workspaces.empty? %>
  <p class="text-sm text-ink-faint">No workspaces connected.</p>
<% elsif data[:total_unread].to_i.zero? %>
  <div class="flex h-full flex-col justify-center text-sm">
    <p class="text-ink-faint">All caught up.</p>
  </div>
<% else %>
  <div class="flex h-full flex-col">
    <div class="flex items-baseline gap-2">
      <span class="font-mono text-3xl font-semibold tabular-nums leading-none text-ink">
        <%= data[:total_unread] %><%= "+" if data[:incomplete] %>
      </span>
      <span class="text-xs text-ink-faint">unread</span>
    </div>
    <% if data[:dm_unread].to_i.positive? %>
      <div class="mt-1 text-xs text-accent"><%= pluralize(data[:dm_unread], "direct message") %></div>
    <% end %>

    <ul class="mt-3 flex-1 space-y-2.5">
      <% workspaces.each do |workspace| %>
        <li>
          <div class="flex items-baseline justify-between gap-2">
            <% if workspace[:url].present? %>
              <%= link_to workspace[:name], workspace[:url], target: "_blank", rel: "noopener noreferrer",
                    class: "truncate text-xs font-medium uppercase tracking-wide text-ink-muted hover:text-ink" %>
            <% else %>
              <span class="truncate text-xs font-medium uppercase tracking-wide text-ink-muted"><%= workspace[:name] %></span>
            <% end %>
            <span class="shrink-0 font-mono text-sm tabular-nums text-ink-muted"><%= workspace[:total_unread] %></span>
          </div>

          <% top = workspace[:top] || [] %>
          <% if top.any? %>
            <ul class="mt-1 space-y-0.5">
              <% top.first(3).each do |conversation| %>
                <li class="flex items-baseline justify-between gap-2 text-xs">
                  <span class="truncate <%= conversation[:direct] ? "text-accent" : "text-ink-muted" %>">
                    <%= conversation[:name] %>
                  </span>
                  <span class="shrink-0 font-mono tabular-nums text-ink-faint"><%= conversation[:unread] %></span>
                </li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ul>

    <% if data[:uncounted].to_i.positive? %>
      <%# Actionable, unlike the budget case: Slack only returns channel unread
          counts to a token holding the history scopes. %>
      <p class="mt-2 border-t border-line/60 pt-2 text-[11px] text-ink-faint">
        <%= pluralize(data[:uncounted], "conversation") %> couldn't be counted —
        <%= link_to "reconnect Slack", connections_path, class: "text-accent hover:underline" %>
        to include channels.
      </p>
    <% elsif data[:incomplete] %>
      <p class="mt-2 border-t border-line/60 pt-2 text-[11px] text-ink-faint">
        Counted the busiest conversations; Slack has no bulk unread API.
      </p>
    <% end %>
    <% if data[:partial] %>
      <p class="mt-1 text-xs text-warn/80">Some workspaces couldn't be reached.</p>
    <% end %>
  </div>
<% end %>
